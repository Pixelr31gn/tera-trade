# Copy this file to .env in the repo root and fill in real values.
# `.env` is git-ignored -- never commit real secrets.

# --- App / API ---
ENVIRONMENT=development
LOG_LEVEL=INFO
API_KEY=change-me-dev-key
NEXT_PUBLIC_API_BASE_URL=http://localhost:8000
NEXT_PUBLIC_API_KEY=change-me-dev-key

# --- Database (used directly by docker-compose for the timescaledb container) ---
POSTGRES_USER=terra
POSTGRES_PASSWORD=terra
POSTGRES_DB=terra_trade
# DATABASE_URL is set automatically by docker-compose from the POSTGRES_* vars above.
# Only set it here if you're running the backend outside Docker, e.g.:
# DATABASE_URL=postgresql+asyncpg://terra:terra@localhost:5432/terra_trade

# --- Trading mode / broker ---
# Terra Trade always boots in analysis_only until you change this. Reaching
# `live` also requires BROKER_KIND=projectx AND LIVE_TRADING_CONFIRMED=true.
TRADING_MODE=analysis_only
BROKER_KIND=simulated
LIVE_TRADING_CONFIRMED=false

# --- ProjectX Gateway (Topstep) -- only needed once BROKER_KIND=projectx ---
PROJECTX_BASE_URL=https://api.topstepx.com
PROJECTX_RTC_URL=https://rtc.topstepx.com
PROJECTX_USERNAME=
PROJECTX_API_KEY=
PROJECTX_ACCOUNT_ID=

# --- Instruments ---
INSTRUMENT_SYMBOLS=ES,NQ,CL,GC

# --- Historical backfill ---
HISTORICAL_BACKFILL_DAYS=365
BAR_INTERVAL_MINUTES=1

# --- News / calendar ---
NEWS_CALENDAR_URL=https://nfs.faireconomy.media/ff_calendar_thisweek.json
NEWS_RISK_WINDOW_MINUTES=15
NEWS_HIGH_IMPACT_ONLY=true

# --- Scoring ---
MIN_SCORE_THRESHOLD=0.65

# --- Risk defaults ---
DEFAULT_PER_TRADE_RISK_PCT=0.5
DEFAULT_MAX_DAILY_LOSS_PCT=3.0
DEFAULT_MAX_TRAILING_DRAWDOWN_PCT=6.0
DEFAULT_MAX_POSITION_SIZE=3
MAX_CONSECUTIVE_LOSSES=3
MAX_DAILY_TRADES=8

# --- Engine ---
ENGINE_POLL_SECONDS=30
