# Copy this file to .env in the repo root and fill in real values.
# `.env` is git-ignored -- never commit real secrets.

# --- App / API ---
ENVIRONMENT=development
LOG_LEVEL=info
API_KEY=change-me-dev-key
NEXT_PUBLIC_API_BASE_URL=http://localhost:8000
NEXT_PUBLIC_API_KEY=change-me-dev-key
PORT=8000

# --- Database ---
# Plain hosted Postgres (Neon: https://neon.tech, free tier, no card required).
# Create a project, copy its connection string (with ?sslmode=require), and
# paste it here. No TimescaleDB extension -- see docs/ARCHITECTURE.md for how
# bar rollups are handled without it.
DATABASE_URL=postgresql://user:password@ep-example-12345.us-east-2.aws.neon.tech/terra_trade?sslmode=require

# --- Trading mode / broker ---
# Tera Trade always boots in analysis_only until you change this. `paper` mode
# requires BROKER_KIND=simulated (guarantees no real orders). Reaching `live`
# requires BROKER_KIND=projectx or browser_control AND LIVE_TRADING_CONFIRMED=true.
TRADING_MODE=analysis_only
BROKER_KIND=simulated
LIVE_TRADING_CONFIRMED=false

# --- ProjectX Gateway (Topstep) -- only needed once BROKER_KIND=projectx ---
PROJECTX_BASE_URL=https://api.topstepx.com
PROJECTX_RTC_URL=https://rtc.topstepx.com
PROJECTX_USERNAME=
PROJECTX_API_KEY=
PROJECTX_ACCOUNT_ID=

# --- Instruments ---
INSTRUMENT_SYMBOLS=ES,NQ,CL,GC

# --- Historical backfill ---
HISTORICAL_BACKFILL_DAYS=365
BAR_INTERVAL_MINUTES=5

# --- News / calendar ---
NEWS_CALENDAR_URL=https://nfs.faireconomy.media/ff_calendar_thisweek.json
NEWS_RISK_WINDOW_MINUTES=15
NEWS_HIGH_IMPACT_ONLY=true

# --- Scoring ---
MIN_SCORE_THRESHOLD=0.65

# --- Risk defaults ---
DEFAULT_PER_TRADE_RISK_PCT=0.5
DEFAULT_MAX_DAILY_LOSS_PCT=3.0
DEFAULT_MAX_TRAILING_DRAWDOWN_PCT=6.0
DEFAULT_MAX_POSITION_SIZE=3
MAX_CONSECUTIVE_LOSSES=3
MAX_DAILY_TRADES=8

# --- Engine ---
ENGINE_POLL_SECONDS=30

# --- Browser-attach data source (optional, no ProjectX API key needed) ---
# Reads account balance/P&L and prices directly off TopstepX's web platform in
# your own already-logged-in Chrome, read-only, via Chrome DevTools Protocol.
# See docs/BROWSER_WATCH.md before enabling either of these.
PRICE_SOURCE=yahoo
ACCOUNT_SOURCE=simulated
BROWSER_CDP_URL=http://localhost:9222
BROWSER_URL_MATCH=topstepx.com
BROWSER_POLL_SECONDS=5
BROWSER_SELECTORS_PATH=

# --- Browser-control (real order placement via mouse/click automation) ---
# Only takes effect once BROKER_KIND=browser_control AND TRADING_MODE=live AND
# LIVE_TRADING_CONFIRMED=true. Defaults to dry-run (true) -- with it on, every
# step short of the final Buy/Sell/Close click still happens for real (qty,
# $ risk/profit brackets) but the click itself is only highlighted, never
# submitted. See docs/BROWSER_CONTROL.md before setting this to false.
DRY_RUN_ORDERS=true
