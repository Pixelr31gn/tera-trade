# Copy to .env.local (git-ignored) before running the dashboard.
# No API key here anymore -- the dashboard now authenticates via the login
# screen (password checked against the backend's AUTH_PASSWORD_HASH, see
# ../backend/.env and `npm run auth:set-password` in backend/), not a key
# baked into this public build.
NEXT_PUBLIC_API_BASE_URL=http://localhost:8000
