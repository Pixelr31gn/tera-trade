// Tera Trade database schema (plain PostgreSQL -- e.g. Neon).
//
// No TimescaleDB extension here (not available on free hosted Postgres), so
// bars_1m/scores/equity_curve are plain indexed tables. Regime snapshots and
// order-flow data are intentionally NOT persisted here (see
// engine/regimeSnapshotCache.ts / engine/liveOrderFlowCache.ts) -- both are
// in-memory only, since scoring only ever reads the live in-memory reading,
// never a DB row (2026-07-20 DB audit).

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Instrument {
  id         Int     @id @default(autoincrement())
  symbol     String  @unique
  dataSymbol String  @map("data_symbol")
  exchange   String  @default("CME")
  contractId String? @map("contract_id")
  tickSize   Decimal @map("tick_size") @db.Decimal(18, 8)
  pointValue Decimal @map("point_value") @db.Decimal(18, 8)
  active     Boolean @default(true)

  @@map("instruments")
}

model Bar {
  time   DateTime
  symbol String
  open   Decimal  @db.Decimal(18, 8)
  high   Decimal  @db.Decimal(18, 8)
  low    Decimal  @db.Decimal(18, 8)
  close  Decimal  @db.Decimal(18, 8)
  volume Decimal  @default(0) @db.Decimal(20, 4)

  @@id([time, symbol])
  @@index([symbol, time])
  @@map("bars_1m")
}

model DailyBar {
  date   DateTime @db.Date
  symbol String
  open   Decimal  @db.Decimal(18, 8)
  high   Decimal  @db.Decimal(18, 8)
  low    Decimal  @db.Decimal(18, 8)
  close  Decimal  @db.Decimal(18, 8)
  volume Decimal  @default(0) @db.Decimal(20, 4)

  @@id([date, symbol])
  @@index([symbol, date])
  @@map("bars_daily")
}

model Account {
  id              Int      @id @default(autoincrement())
  brokerAccountId String?  @map("broker_account_id")
  name            String   @default("default")
  startingBalance Decimal  @default(50000) @map("starting_balance") @db.Decimal(18, 2)
  isActive        Boolean  @default(true) @map("is_active")
  createdAt       DateTime @default(now()) @map("created_at")

  riskLimit    RiskLimit?
  trades       Trade[]
  orders       OrderRecord[]
  equityPoints EquityCurvePoint[]

  @@map("accounts")
}

model RiskLimit {
  id                     Int     @id @default(autoincrement())
  accountId              Int     @unique @map("account_id")
  perTradeRiskPct        Decimal @default(0.5) @map("per_trade_risk_pct") @db.Decimal(6, 3)
  maxDailyLossPct        Decimal @default(3.0) @map("max_daily_loss_pct") @db.Decimal(6, 3)
  maxTrailingDrawdownPct Decimal @default(6.0) @map("max_trailing_drawdown_pct") @db.Decimal(6, 3)
  maxPositionSize        Int     @default(3) @map("max_position_size")
  maxConsecutiveLosses   Int     @default(3) @map("max_consecutive_losses")
  maxDailyTrades         Int     @default(8) @map("max_daily_trades")

  // Fixed-dollar overrides -- when set, these take priority over the
  // percentage-of-equity fields above, since a funded account's per-trade
  // risk/profit targets are usually meant to stay fixed regardless of how
  // equity fluctuates intraday (see risk/engine.ts).
  perTradeRiskDollars   Decimal? @map("per_trade_risk_dollars") @db.Decimal(10, 2)
  perTradeProfitDollars Decimal? @map("per_trade_profit_dollars") @db.Decimal(10, 2)
  maxDailyLossDollars   Decimal? @map("max_daily_loss_dollars") @db.Decimal(10, 2)

  account Account @relation(fields: [accountId], references: [id])

  @@map("risk_limits")
}

model SystemState {
  id               Int      @id @default(1)
  mode             String   @default("analysis_only")
  killSwitch       Boolean  @default(false) @map("kill_switch")
  killSwitchReason String?  @map("kill_switch_reason")
  updatedAt        DateTime @default(now()) @updatedAt @map("updated_at")

  /// Which scoring strategy version (see scoring/ruleScorer.ts) actually
  /// executes trades. Both versions are scored on every signal regardless
  /// (see engine/loop.ts) so their hypothetical performance stays directly
  /// comparable -- this only controls which one is allowed to place real orders.
  activeStrategyVersion String @default("v1") @map("active_strategy_version")

  /// Live dashboard toggle for the Execution Decision Engine (see
  /// docs/EXECUTION_DECISION_ENGINE.md) -- seeded from EXECUTION_DECISION_ENGINE_ENABLED
  /// the first time this row is created (see execution/mode.ts's getSystemState), then
  /// authoritative from here on, same "env sets the boot default, DB is live from then on"
  /// pattern as `mode` above. Only takes effect when the broker kind is browser_control
  /// (see engine/loop.ts's attemptExecution) regardless of this flag's value.
  executionDecisionEngineEnabled Boolean @default(false) @map("execution_decision_engine_enabled")

  /// Reward:risk multiple applied to every signal's take-profit target (see
  /// risk/stops.ts's computeInitialStop) -- shared across all strategies and
  /// scoring versions (v1/v2/v3/v5/v6+), since target computation has never
  /// branched by strategyId or version. Default 2.0, NOT stops.ts's own 3.0
  /// fallback -- 2.0 was risk/engine.ts's hardcoded real-execution value
  /// since 2026-07-29 (see assessNewTrade's comment on why), and this column
  /// replaces that hardcoding, so the seeded default must match what was
  /// actually trading, not the generic pure-function fallback (2026-08-02,
  /// made operator-adjustable at runtime, no restart, same "env sets the
  /// boot default, DB is live from then on" pattern as activeStrategyVersion
  /// above).
  takeProfitRMultiple Decimal @default(2.0) @map("take_profit_r_multiple")

  /// Confidence-tier position sizing (see risk/sizing.ts's
  /// computeConfidenceTierQuantity) -- quantity placed is set directly by
  /// which of these three probability tiers the cross-version consensus
  /// average clears, lowest tier first as the floor. Defaults match the
  /// values operator-requested 2026-08-02 (65/75/85%); previously hardcoded
  /// at 65/71/82%.
  confidenceTier1Threshold Decimal @default(0.65) @map("confidence_tier_1_threshold")
  confidenceTier1Quantity  Int     @default(1) @map("confidence_tier_1_quantity")
  confidenceTier2Threshold Decimal @default(0.75) @map("confidence_tier_2_threshold")
  confidenceTier2Quantity  Int     @default(2) @map("confidence_tier_2_quantity")
  confidenceTier3Threshold Decimal @default(0.85) @map("confidence_tier_3_threshold")
  confidenceTier3Quantity  Int     @default(3) @map("confidence_tier_3_quantity")

  @@map("system_state")
}

model NewsEvent {
  id        Int      @id @default(autoincrement())
  eventTime DateTime @map("event_time")
  country   String
  name      String
  impact    String
  forecast  String?
  previous  String?
  fetchedAt DateTime @default(now()) @map("fetched_at")

  @@unique([eventTime, country, name])
  @@index([eventTime])
  @@map("news_events")
}

model Score {
  id             Int       @id @default(autoincrement())
  time           DateTime
  symbol         String
  strategyId     String    @map("strategy_id")
  side           String
  probability    Decimal   @db.Decimal(6, 5)
  decision       String
  features       Json
  explanation    String
  tradeId        Int?      @map("trade_id")
  acknowledged   Boolean   @default(false)
  acknowledgedAt DateTime? @map("acknowledged_at")

  /// Trading session at signal time -- "new_york" | "london" | "asian". Kept
  /// as its own indexed column (not just inside `features`) since per-session
  /// datasets must never be queried/trained together.
  session String

  /// Hypothetical entry/stop/ATR captured at signal time so a *skipped*
  /// setup's outcome can still be retrospectively simulated later -- without
  /// these, only "taken" trades would ever be labeled.
  entryPriceAtSignal          Decimal  @map("entry_price_at_signal") @db.Decimal(18, 8)
  structureSwingPriceAtSignal Decimal? @map("structure_swing_price_at_signal") @db.Decimal(18, 8)
  atrAtSignal                 Decimal  @map("atr_at_signal") @db.Decimal(18, 8)
  riskRewardRatio             Decimal? @map("risk_reward_ratio") @db.Decimal(6, 3)

  /// "breakout" | "reversal" | null (continuous-scan rows have no real
  /// signal, so no kind) -- see strategy/types.ts's Signal.signalKind. Needed
  /// to accurately replay the risk engine's S/R gate later (e.g. for the
  /// actionable-recommendations endpoint's "would this really execute"
  /// check) -- that gate behaves differently for a breakout than a
  /// reversal, and there was previously no way to reconstruct which one a
  /// past signal was.
  signalKind         String?  @map("signal_kind")
  /// Only set when signalKind is "breakout": the actual prior high/low the
  /// signal broke through (see Signal.breakoutLevelPrice's comment).
  breakoutLevelPrice Decimal? @map("breakout_level_price") @db.Decimal(18, 8)

  /// Filled in later by the outcome evaluator (engine/outcomeEvaluator.ts):
  /// "executed_win" | "executed_loss" | "missed_win" | "missed_loss" |
  /// "no_resolution" | null (still pending -- not enough time/bars have
  /// passed yet to judge).
  outcomeLabel       String?   @map("outcome_label")
  outcomeRMultiple   Decimal?  @map("outcome_r_multiple") @db.Decimal(8, 3)
  outcomeEvaluatedAt DateTime? @map("outcome_evaluated_at")

  /// Which scoring strategy version produced this row -- "v1" | "v2". Both
  /// versions are scored on every signal in parallel (shadow scoring, see
  /// engine/loop.ts) so their outcomes stay directly comparable over the
  /// exact same market conditions; only one version's rows ever reach real
  /// execution (see SystemState.activeStrategyVersion).
  strategyVersion String @default("v1") @map("strategy_version")

  /// Coarse categorical fingerprint of market conditions at signal time --
  /// only populated for v3 rows (see scoring/ruleScorerV3.ts's
  /// computeV3Bucket). Used by scoring/v3HistoricalAdjustment.ts to find the
  /// most recent resolved setups that looked similar, so a new setup's score
  /// can be adjusted by how well similar-looking setups actually performed.
  v3Bucket String? @map("v3_bucket")

  /// Denormalized copies of the same-named fields inside `features` (JSON).
  /// The session-performance/strategy-comparison analytics queries only
  /// ever need these three scalars, not the whole feature vector -- pulling
  /// the full `features` blob for every row in the lookback window was
  /// measured at ~28s for ~12,700 rows (JSON payload size, not a missing
  /// index -- those queries intentionally select most of the table, where a
  /// sequential scan already beats an index scan). Flat columns here let
  /// those endpoints select a handful of small strings instead. Only
  /// populated going forward; existing rows carry these as null.
  marketStructureLabel String? @map("market_structure_label")
  liquidityLabel       String? @map("liquidity_label")
  priceActionLabel     String? @map("price_action_label")

  trade Trade? @relation(fields: [tradeId], references: [id])

  @@unique([time, symbol, strategyId, strategyVersion])
  @@index([symbol, time])
  @@index([decision, acknowledged, time])
  @@index([session, outcomeLabel])
  @@index([strategyVersion, session, outcomeLabel])
  @@index([strategyVersion, v3Bucket, time])
  @@index([time, session])
  @@index([outcomeLabel, tradeId])
  @@map("scores")
}

model Trade {
  id                 Int       @id @default(autoincrement())
  accountId          Int       @map("account_id")
  symbol             String
  strategyId         String    @map("strategy_id")
  side               String
  quantity           Int
  entryTime          DateTime  @map("entry_time")
  entryPrice         Decimal   @map("entry_price") @db.Decimal(18, 8)
  stopPrice          Decimal   @map("stop_price") @db.Decimal(18, 8)
  takeProfitPrice    Decimal?  @map("take_profit_price") @db.Decimal(18, 8)
  exitTime           DateTime? @map("exit_time")
  exitPrice          Decimal?  @map("exit_price") @db.Decimal(18, 8)
  exitReason         String?   @map("exit_reason")
  pnl                Decimal?  @db.Decimal(18, 2)
  fees               Decimal   @default(0) @db.Decimal(18, 2)
  mae                Decimal?  @db.Decimal(18, 8)
  mfe                Decimal?  @db.Decimal(18, 8)
  score              Decimal?  @db.Decimal(6, 5)
  /// Execution Decision Engine only (null for market-order trades via execution/engine.ts) --
  /// the winning entryQualityModel ladder score (0-105ish, see execution/entryQualityModel.ts)
  /// at the moment the resting limit order filled. Data collection for the (deferred)
  /// self-adjusting weight recalibration described in the EDE spec -- not yet consumed anywhere.
  entryQualityScore  Decimal?  @db.Decimal(6, 2) @map("entry_quality_score")
  /// Execution Decision Engine only -- seconds between the resting limit order being placed and
  /// its confirmed fill (see execution/executionDecisionEngine.ts). Null for market-order trades,
  /// where fill is effectively instantaneous and there's nothing meaningful to record.
  timeToFillSeconds  Int?      @map("time_to_fill_seconds")
  regimeTrendAtEntry String?   @map("regime_trend_at_entry")
  regimeVolAtEntry   String?   @map("regime_vol_at_entry")
  explanation        String    @default("")
  status             String    @default("open")
  brokerOrderId      String?   @map("broker_order_id")
  /// Which broker actually owns this position ("simulated" | "browser_control" | "projectx") -- recorded at entry so an
  /// open trade is always managed by the correct broker regardless of later system-mode switches (see engine/loop.ts's
  /// brokerForTrade). Defaults to "simulated" for pre-migration rows; safe since no trade was open when this was added.
  brokerKind         String    @default("simulated") @map("broker_kind")
  /// v1.3: has a real broker-side Trailing Stop order been placed for this trade yet (see
  /// engine/loop.ts's trailing-stop activation check -- once price reaches halfway to the
  /// take-profit target, a real trailing-stop order replaces our own internal hard-stop-price
  /// check as the trade's downside protection). False for every trade before v1.3 and for any
  /// trade that hasn't reached the activation threshold yet.
  trailingStopPlaced Boolean   @default(false) @map("trailing_stop_placed")
  /// v1.3 operator override (Positions panel "let it ride" toggle) -- once true, the internal
  /// take-profit check in engine/loop.ts's manageLiveOpenTrade no longer force-closes this trade
  /// at its stored takeProfitPrice; only the real trailing-stop order (once placed) can close it.
  /// Meant for exactly one case: the operator sees something the system doesn't and wants to let
  /// a winner run past its original target.
  letItRide          Boolean   @default(false) @map("let_it_ride")

  account Account       @relation(fields: [accountId], references: [id])
  orders  OrderRecord[]
  scores  Score[]

  @@index([symbol])
  @@index([accountId, status, brokerKind])
  @@map("trades")
}

model OrderRecord {
  id            Int       @id @default(autoincrement())
  tradeId       Int?      @map("trade_id")
  brokerOrderId String?   @map("broker_order_id")
  accountId     Int       @map("account_id")
  symbol        String
  orderType     String    @map("order_type")
  side          String
  quantity      Int
  price         Decimal?  @db.Decimal(18, 8)
  status        String    @default("pending")
  createdAt     DateTime  @default(now()) @map("created_at")
  filledAt      DateTime? @map("filled_at")
  filledPrice   Decimal?  @map("filled_price") @db.Decimal(18, 8)

  account Account @relation(fields: [accountId], references: [id])
  trade   Trade?  @relation(fields: [tradeId], references: [id])

  @@map("orders")
}

model EquityCurvePoint {
  time       DateTime
  accountId  Int      @map("account_id")
  equity     Decimal  @db.Decimal(18, 2)
  balance    Decimal  @db.Decimal(18, 2)
  /// Which broker this point reflects ("simulated" | "browser_control" | "projectx") -- paper and live share one
  /// account row, so without this, peak-equity/drawdown circuit breakers would mix a live account's real balance
  /// with a paper run's simulated one into the same curve. Part of the primary key so a live and paper point can
  /// both exist for the same instant.
  brokerKind String   @default("simulated") @map("broker_kind")

  account Account @relation(fields: [accountId], references: [id])

  @@id([time, accountId, brokerKind])
  @@index([accountId, brokerKind, time])
  @@map("equity_curve")
}
