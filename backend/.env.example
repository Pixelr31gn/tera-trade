# Copy this file to backend/.env and fill in real values.
# `.env` is git-ignored -- never commit real secrets. This file MUST live in
# backend/ (not the repo root) -- src/env.ts only ever looks next to itself.

# --- License (see ../LICENSE.md) ---
# Issued to you when you purchased/were granted access. The app will not
# start without a valid key -- see backend/src/core/license.ts.
LICENSE_KEY=
LICENSED_TO=

# --- App / API ---
ENVIRONMENT=development
LOG_LEVEL=info
API_KEY=change-me-dev-key
PORT=8000

# --- Dashboard login (see src/core/auth.ts) ---
# Don't fill these in by hand -- run `npm run auth:set-password` after
# copying this file to .env; it prompts for a password and writes both
# values below itself. Login is refused until AUTH_PASSWORD_HASH is set
# (fails closed, not open). A future TOTP second factor will sit alongside
# these without changing either.
AUTH_PASSWORD_HASH=
SESSION_SECRET=

# --- Database ---
# Your own local Postgres, run in Docker (see docker-compose.yml at the repo
# root) -- scripts\setup.ps1 starts the container and fills this in for you
# automatically. No hosted database account needed.
DATABASE_URL=postgresql://teratrade:change-me@localhost:5432/teratrade?schema=public

# --- Trading mode / broker ---
# `paper` mode requires BROKER_KIND=simulated (guarantees no real orders --
# recommended until you've watched it trade for a long while). Reaching
# `live` requires BROKER_KIND=projectx or browser_control AND
# LIVE_TRADING_CONFIRMED=true -- both, deliberately, so nothing can
# auto-escalate from paper to live by itself.
#
# Defaulted to live (2026-08-13, operator request for the Tera Trade 2.0.0
# .exe deliverable specifically: "packaged with live trade mode = true or
# enabled") -- a fresh install from that package is fully live from first
# launch, no manual .env edit needed after setup. If you're reading this
# .env.example for a from-source checkout instead, change these back to
# paper/simulated/false (and DRY_RUN_ORDERS below back to true) unless you
# specifically want the same live-by-default behavior there too.
TRADING_MODE=live
BROKER_KIND=browser_control
LIVE_TRADING_CONFIRMED=true

# Account-wide daily-loss/trailing-drawdown auto-stop. Leave this at `true`
# always, unless you are deliberately doing short, closely-watched testing --
# this is the thing that stops a broken strategy from digging a real funded
# account into a hole. Re-enable before ever reaching live trading.
KILL_SWITCH_ENABLED=true

# --- ProjectX Gateway (Topstep) -- only needed once BROKER_KIND=projectx ---
PROJECTX_BASE_URL=https://api.topstepx.com
PROJECTX_RTC_URL=https://rtc.topstepx.com
PROJECTX_USERNAME=
PROJECTX_API_KEY=
PROJECTX_ACCOUNT_ID=

# --- Instruments ---
# Which symbols get actively scanned/traded -- see
# src/marketData/instruments.ts's ACTIVE_INSTRUMENTS for the subset actually
# used by the live engine loop (currently hardcoded to ES/NQ; CL/GC stay
# registered for historical/reference data but aren't scanned).
INSTRUMENT_SYMBOLS=ES,NQ,CL,GC

# --- Historical backfill ---
HISTORICAL_BACKFILL_DAYS=365
BAR_INTERVAL_MINUTES=5

# --- News / calendar ---
NEWS_CALENDAR_URL=https://nfs.faireconomy.media/ff_calendar_thisweek.json
NEWS_RISK_WINDOW_MINUTES=15
NEWS_HIGH_IMPACT_ONLY=true

# --- Scoring ---
MIN_SCORE_THRESHOLD=0.65

# --- Risk defaults (percentage-of-equity based; used only when a new
# account row is first created, and overridden by the fixed-dollar fields
# below if those are set on the account's RiskLimit row) ---
DEFAULT_PER_TRADE_RISK_PCT=0.5
DEFAULT_MAX_DAILY_LOSS_PCT=3.0
DEFAULT_MAX_TRAILING_DRAWDOWN_PCT=6.0
DEFAULT_MAX_POSITION_SIZE=3
MAX_CONSECUTIVE_LOSSES=3
MAX_DAILY_TRADES=8

# --- Risk defaults (fixed-dollar overrides, optional) ---
DEFAULT_PER_TRADE_RISK_DOLLARS=
DEFAULT_PER_TRADE_PROFIT_DOLLARS=
DEFAULT_MAX_DAILY_LOSS_DOLLARS=

# --- Engine ---
# Only used by the non-browser (Yahoo Finance) price path -- irrelevant once
# PRICE_SOURCE=browser, since ticks drive the engine directly instead.
ENGINE_POLL_SECONDS=30

# --- Browser-attach data source (real-time prices/account data, no
# ProjectX API key needed) -- see docs/BROWSER_WATCH.md before enabling. ---
PRICE_SOURCE=browser
ACCOUNT_SOURCE=browser
BROWSER_CDP_URL=http://localhost:9222
BROWSER_URL_MATCH=topstepx.com
BROWSER_POLL_SECONDS=5
BROWSER_SELECTORS_PATH=

# --- Automatic debug-mode Chrome launch (see
# src/browserWatch/chromeLauncher.ts) -- the app launches and manages its
# own dedicated Chrome profile for you, so you don't have to start Chrome
# with --remote-debugging-port by hand. Only relevant when PRICE_SOURCE or
# ACCOUNT_SOURCE is `browser`. The very first launch opens to a login page --
# log into TopstepX once and the session persists after that. ---
CHROME_AUTO_LAUNCH=true
CHROME_EXECUTABLE_PATH=
CHROME_DEBUG_USER_DATA_DIR=
CHROME_DEBUG_START_URL=https://topstepx.com/

# Opened as a second tab in the same debug Chrome session once the frontend
# dev server is reachable, so the dashboard always ends up next to the
# TopstepX tab instead of a separate manual browser window. Blank disables
# this.
DASHBOARD_URL=http://localhost:3000

# --- Order-flow listener (reads live bid/ask size + trade-aggressor flow
# off the same TopstepX tab's WebSocket traffic -- observational only right
# now, not yet used by scoring) ---
ORDER_FLOW_ENABLED=true
ORDER_FLOW_FLUSH_SECONDS=10

# --- Browser-control (real order placement via mouse/click automation) ---
# Only takes effect once BROKER_KIND=browser_control AND TRADING_MODE=live AND
# LIVE_TRADING_CONFIRMED=true. With dry-run on, every step short of the final
# Buy/Sell/Close click still happens for real (qty, $ risk/profit brackets)
# but the click itself is only highlighted, never submitted. See
# docs/BROWSER_CONTROL.md before setting this to false.
#
# Defaulted to false (2026-08-13, operator request, see TRADING_MODE's own
# comment above for the full context) -- paired with the three flags above,
# this means a fresh Tera Trade 2.0.0 install clicks real Buy/Sell/Close
# buttons on your real account as soon as it's set up and TopstepX is logged
# in. Set back to true if you want to watch dry-run signals first before
# real orders can go out.
DRY_RUN_ORDERS=false

# --- Tradesea (second concurrent live broker, app.tradesea.ai) ---
# Fully independent of everything above -- TRADING_MODE/BROKER_KIND/
# LIVE_TRADING_CONFIRMED/DRY_RUN_ORDERS keep gating TopstepX only, unchanged.
# Defaults to fully off/safe: an existing install is unaffected until you
# explicitly set TRADESEA_ENABLED=true, and even then real clicks require
# TRADESEA_DRY_RUN_ORDERS=false AND TRADESEA_LIVE_TRADING_CONFIRMED=true AND
# the runtime tradeseaLiveEnabled switch (POST /api/system/tradesea/live-enabled)
# all three, same layered-opt-in posture as TopstepX's own four gates.
TRADESEA_ENABLED=false
TRADESEA_BROWSER_CDP_URL=http://localhost:9223
TRADESEA_BROWSER_URL_MATCH=app.tradesea.ai
TRADESEA_DRY_RUN_ORDERS=true
TRADESEA_LIVE_TRADING_CONFIRMED=false

# Each optional -- falls back to the matching DEFAULT_* value above (same
# risk posture as TopstepX) when left blank.
TRADESEA_DEFAULT_PER_TRADE_RISK_PCT=
TRADESEA_DEFAULT_MAX_DAILY_LOSS_PCT=
TRADESEA_DEFAULT_MAX_TRAILING_DRAWDOWN_PCT=
TRADESEA_DEFAULT_MAX_POSITION_SIZE=
TRADESEA_MAX_CONSECUTIVE_LOSSES=
TRADESEA_MAX_DAILY_TRADES=

# --- AI assistant (in-app "Quin"-equivalent, see backend/src/assistant/) ---
# Off by default. Uses Google Gemini (aistudio.google.com, free tier), not
# Anthropic -- picked for its function-calling reliability in multi-turn
# agent loops over the other free/cheap alternative considered (xAI/Grok).
# Reaching a state where it can autonomously place real orders/change
# settings (no human confirmation step -- an explicit operator choice)
# requires ALL of: GEMINI_API_KEY set, ASSISTANT_ENABLED=true,
# ASSISTANT_ACTIONS_CONFIRMED=true, AND the runtime assistantActionsEnabled
# DB toggle (POST /api/system/assistant/actions-enabled) -- a single flip on
# that last toggle disables only the assistant's write-tools, independent of
# every other trading gate in this app.
GEMINI_API_KEY=
ASSISTANT_MODEL=gemini-3.5-flash
ASSISTANT_ENABLED=false
ASSISTANT_ACTIONS_CONFIRMED=false

# Set ASSISTANT_PROVIDER=ollama to run the assistant (chat + the daily-plan
# scheduler) against a self-hosted Ollama server instead of Gemini -- removes
# Gemini's free-tier caps entirely. OLLAMA_BASE_URL defaults to localhost;
# if the model is hosted on another machine, point this at that machine's
# Tailscale address (e.g. http://100.x.y.z:11434) rather than exposing
# Ollama's port to the public internet -- do NOT change GEMINI_API_KEY/
# ASSISTANT_MODEL above when using this path, they're simply unused.
ASSISTANT_PROVIDER=gemini
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=qwen2.5:14b
