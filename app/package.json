{
  "name": "tera-trade-backend",
  "version": "1.4.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "build": "tsc -p tsconfig.json && node -e \"require('fs').cpSync('src/scoring/artifacts','dist/scoring/artifacts',{recursive:true})\"",
    "start": "node dist/index.js",
    "test": "vitest run",
    "prisma:generate": "prisma generate",
    "prisma:migrate": "prisma migrate deploy",
    "prisma:migrate:dev": "prisma migrate dev",
    "license:generate": "tsx --env-file=.env scripts/generateLicenseKey.ts",
    "train:v4": "tsx --env-file=.env scripts/trainV4Model.ts"
  },
  "dependencies": {
    "@fastify/cors": "^10.0.1",
    "@fastify/websocket": "^11.0.2",
    "@microsoft/signalr": "^8.0.7",
    "@prisma/client": "^5.22.0",
    "decimal.js": "^10.4.3",
    "fastify": "^5.1.0",
    "pino": "^9.5.0",
    "playwright-core": "^1.48.2",
    "ws": "^8.18.0",
    "zod": "^3.23.8"
  },
  "devDependencies": {
    "@types/node": "^22.9.0",
    "@types/ws": "^8.5.13",
    "pino-pretty": "^13.0.0",
    "prisma": "^5.22.0",
    "tsx": "^4.19.2",
    "typescript": "^5.6.3",
    "vitest": "^4.0.0"
  }
}
